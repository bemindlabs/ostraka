/target
**/*.rs.bk

# Worktrees the runtime creates for agent tasks.
/worktrees/

# Run records and caches. See the open question in the workspace notes about
# whether records belong in history; they are untracked until that is settled.
/.ostraka/runs/
/.ostraka/cache/

# Benchmark reports. Working evidence like a run record: the suite that
# produced them is committed, the numbers a particular machine got are not.
/.ostraka/bench/

# Never commit resolved credentials.
/.ostraka/secrets/

# npm reads a token from any .npmrc up the tree, including one sitting beside
# npm/package.json. Publishing is a hand-run command with a credential in the
# environment, so the file it would land in is named here before it exists —
# a token is not something to notice in a diff after the fact.
.npmrc

# Relocated vendor home directories: how a CLI with no isolation flag is kept
# from reading the operator's own configuration. Contains links to credentials.
/.ostraka/vendor-home/

node_modules/
.DS_Store
*.swp
*~

# The claude-mem plugin writes a CLAUDE.md into whatever directory it is working
# in. In this repository the only legitimate one is the root symlink to
# AGENTS.md; every other copy is scribble that has twice reached a commit.
CLAUDE.md
!/CLAUDE.md
